# ==============================================================================
# DORO Games Server Environment Variables Template
# 이 파일을 .env 로 복사해 환경에 맞게 값을 설정하세요. 실제 값은 저장소에 올리지 않습니다.
# ==============================================================================

# 1. Database (PostgreSQL, 서비스 전용 DB)
DB_HOST=localhost
DB_PORT=25432
DB_NAME=service_games
DB_USER=doro_admin
DB_PASSWORD=change-me

# 2. DORO IAM / Guard
IAM_HOST=localhost
IAM_PORT=28080
GUARD_GRPC_HOST=localhost
GUARD_GRPC_PORT=9090
GUARD_HTTP_HOST=localhost
GUARD_HTTP_PORT=28081
DORO_GUARD_SERVICE_TOKEN=

# 3. 토큰 검증 (로그인·세션은 별도 BFF(doro-bff)가 하고, 게이트웨이가 Bearer 를 붙여 준다)
# 받아 주는 토큰의 OAuth 클라이언트(cid)
GAMES_OAUTH_CLIENT_ID=doro-games
# 점수 규칙(게임별 초당 최대 점수). 기본값은 application.yaml
